@model ErrorViewModel
@{
    ViewData["Title"] = "সার্ভার সমস্যা — Error";
}

<main class="container" id="main">
    <div class="error-wrap">
        <div class="error-code">500</div>
        <h1 class="page-title" data-bn="একটি ত্রুটি ঘটেছে" data-en="An Error Occurred">একটি ত্রুটি ঘটেছে</h1>
        <p class="muted" data-bn="আপনার অনুরোধ প্রক্রিয়াকরণের সময় একটি অপ্রত্যাশিত সমস্যা হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।" data-en="Something went wrong while processing your request. Please try again.">আপনার অনুরোধ প্রক্রিয়াকরণের সময় একটি অপ্রত্যাশিত সমস্যা হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।</p>

        @if (Model.ShowRequestId)
        {
            <p class="tiny muted" data-bn="অনুরোধ আইডি:" data-en="Request ID:">অনুরোধ আইডি: <code>@Model.RequestId</code></p>
        }

        <div class="row wrap" style="justify-content: center; gap: 10px; margin-top: 10px;">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
                <i data-lucide="home"></i> <span data-bn="হোমে ফিরে যান" data-en="Back to Home">হোমে ফিরে যান</span>
            </a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="tiny muted" style="margin-top: 18px;">
                <span data-bn="ডেভেলপার দেখুন:" data-en="Developers:">ডেভেলপার দেখুন:</span>
                <span data-bn="বিস্তারিত ত্রুটি তথ্য দেখতে Development পরিবেশ সক্রিয় করুন। ডিপ্লয়কৃত অ্যাপে এটি নিষ্ধ।" data-en="Enable the Development environment to see detailed error information. This should not be enabled in deployed applications.">বিস্তারিত ত্রুটি তথ্য দেখতে Development পরিবেশ সক্রিয় করুন। ডিপ্লয়কৃত অ্যাপে এটি নিষ্ধ।</span>
            </p>
        }
    </div>
</main>
