@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var isLawyer = User.IsInRole("Lawyer");
    var isCitizen = isAuthenticated && !isAdmin && !isLawyer;

    var userDisplayName = User.FindFirst("FullName")?.Value;
    if (string.IsNullOrWhiteSpace(userDisplayName))
    {
        userDisplayName = User.Identity?.Name ?? string.Empty;
    }
    
    var userInitial = "U";
    if (!string.IsNullOrWhiteSpace(userDisplayName))
    {
        var trimmed = userDisplayName.Trim();
        userInitial = trimmed.Substring(0, 1).ToUpperInvariant();
    }
}
<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | মুক্ত আইন — MuktoAin</title>
    <meta name="description" content="মুক্ত আইন (MuktoAin) — বাংলাদেশের নাগরিকদের জন্য AI-সহায়ক আইনি তথ্য ও নথি প্রস্তুতকরণ প্ল্যাটফর্ম।" />
    
    <!-- Early theme init to prevent flash -->
    <script>
        var savedTheme = null;
        try { savedTheme = localStorage.getItem('mkt-theme'); } catch(e) {}
        document.documentElement.dataset.theme = savedTheme || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Lora:ital,wght@0,400..700;1,400..700&family=Noto+Sans+Bengali:wght@400;500;600;700;800&family=Noto+Serif+Bengali:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <link rel="stylesheet" href="~/assets/css/main.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">সরাসরি কন্টেন্টে যান / Skip to content</a>

    <!-- ============ NAVBAR ============ -->
    <header class="nav">
        <div class="nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="মুক্ত আইন হোম">
                <span class="brand-name">মুক্ত আইন<small>MuktoAin</small></span>
            </a>
            
            <!-- Dynamic Role-Based Top Navigation Links -->
            <nav class="nav-links" aria-label="প্রধান মেনু">
                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Dashboard"><i data-lucide="shield"></i>ড্যাশবোর্ড</a>
                    <a asp-controller="Admin" asp-action="Analytics"><i data-lucide="bar-chart-3"></i>অ্যানালিটিক্স</a>
                    <a asp-controller="Lawyer" asp-action="Queue"><i data-lucide="file-check-2"></i>রিভিউ কিউ</a>
                    <a asp-controller="Search" asp-action="Index"><i data-lucide="search"></i>আইন ও করপাস</a>
                    <a asp-controller="Case" asp-action="Track"><i data-lucide="folder-clock"></i>সকল মামলা</a>
                }
                else if (isLawyer)
                {
                    <a asp-controller="Lawyer" asp-action="Queue"><i data-lucide="file-check-2"></i>রিভিউ কিউ</a>
                    <a asp-controller="Search" asp-action="Index"><i data-lucide="search"></i>আইন অনুসন্ধান</a>
                    <a asp-controller="Category" asp-action="Index"><i data-lucide="layout-grid"></i>বিভাগসমূহ</a>
                    <a asp-controller="Case" asp-action="Track"><i data-lucide="folder-clock"></i>মামলা ট্র্যাকিং</a>
                    <a asp-controller="Home" asp-action="About"><i data-lucide="info"></i>পরিচিতি</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index"><i data-lucide="message-square"></i>আইনি সেবা</a>
                    <a asp-controller="Case" asp-action="Submit"><i data-lucide="edit-3"></i>সমস্যা জমা দিন</a>
                    <a asp-controller="Case" asp-action="Track"><i data-lucide="folder-clock"></i>মামলা ট্র্যাকিং</a>
                    <a asp-controller="Search" asp-action="Index"><i data-lucide="search"></i>আইন খুঁজুন</a>
                    <a asp-controller="Category" asp-action="Index"><i data-lucide="layout-grid"></i>বিভাগসমূহ</a>
                    <a asp-controller="Home" asp-action="About"><i data-lucide="info"></i>পরিচিতি</a>
                }
            </nav>
            
            <div class="nav-actions">
                <partial name="_LanguageToggle" />
                <button class="icon-btn theme-toggle" type="button" aria-label="থিম পরিবর্তন"></button>
                
                @if (!isAuthenticated)
                {
                    <div class="nav-desktop-auth">
                        <a class="btn btn-outline btn-sm" asp-controller="Account" asp-action="Login">সাইন ইন</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">নিবন্ধন</a>
                    </div>
                }
                else
                {
                    <div class="pop-wrap">
                        <button class="avatar" type="button" data-pop="user-pop" aria-label="ব্যবহারকারী মেনু" title="@userDisplayName">
                            @userInitial
                        </button>
                        <div class="menu-pop" id="user-pop">
                            <div style="padding: 8px 12px; border-bottom: 1px solid var(--border); font-size: 13px;">
                                <strong style="display:block; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@userDisplayName</strong>
                                <span class="muted tiny">@(isAdmin ? "অ্যাডমিন / Administrator" : isLawyer ? "আইনজীবী / Advocate" : "নাগরিক / Citizen")</span>
                            </div>
                            
                            @if (isAdmin)
                            {
                                <a asp-controller="Admin" asp-action="Dashboard"><i data-lucide="shield"></i>অ্যাডমিন ড্যাশবোর্ড</a>
                                <a asp-controller="Admin" asp-action="Analytics"><i data-lucide="bar-chart-3"></i>সিস্টেম অ্যানালিটিক্স</a>
                                <a asp-controller="Lawyer" asp-action="Queue"><i data-lucide="file-check-2"></i>আইনজীবী রিভিউ কিউ</a>
                                <a asp-controller="Case" asp-action="Track"><i data-lucide="folder"></i>সকল মামলাসমূহ</a>
                            }
                            else if (isLawyer)
                            {
                                <a asp-controller="Lawyer" asp-action="Queue"><i data-lucide="file-check-2"></i>আইনজীবী রিভিউ কিউ</a>
                                <a asp-controller="Search" asp-action="Index"><i data-lucide="search"></i>আইন অনুসন্ধান</a>
                                <a asp-controller="Case" asp-action="Track"><i data-lucide="folder"></i>মামলা ট্র্যাকিং</a>
                            }
                            else
                            {
                                <a asp-controller="Case" asp-action="Track"><i data-lucide="folder"></i>আমার মামলাসমূহ</a>
                                <a asp-controller="Case" asp-action="Submit"><i data-lucide="edit-3"></i>নতুন সমস্যা জমা দিন</a>
                            }
                            
                            <hr class="divider" style="margin:4px 0" />
                            <form asp-controller="Account" asp-action="Logout" method="post" class="user-logout-form">
                                <button type="submit" class="user-logout-btn"><i data-lucide="log-out"></i>লগআউট</button>
                            </form>
                        </div>
                    </div>
                }
                
                <button class="icon-btn nav-burger" type="button" aria-label="মেনু খুলুন" aria-expanded="false" aria-controls="drawer">
                    <i data-lucide="menu"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Surface 1 Non-Dismissible Legal Disclaimer -->
    <partial name="_DisclaimerBanner" />

    <!-- Mobile Navigation Drawer -->
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <aside class="drawer" id="drawer" aria-label="মোবাইল মেনু">
        <div class="drawer-head">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-name">মুক্ত আইন<small>MuktoAin</small></span>
            </a>
            <button class="icon-btn" type="button" data-close-drawer aria-label="মেনু বন্ধ করুন">
                <i data-lucide="x"></i>
            </button>
        </div>
        <nav>
            @if (isAdmin)
            {
                <a asp-controller="Admin" asp-action="Dashboard"><i data-lucide="shield"></i> অ্যাডমিন ড্যাশবোর্ড</a>
                <a asp-controller="Admin" asp-action="Analytics"><i data-lucide="bar-chart-3"></i> অ্যানালিটিক্স ও রিপোর্ট</a>
                <a asp-controller="Lawyer" asp-action="Queue"><i data-lucide="file-check-2"></i> আইনজীবী রিভিউ কিউ</a>
                <a asp-controller="Search" asp-action="Index"><i data-lucide="search"></i> আইন ও করপাস</a>
                <a asp-controller="Category" asp-action="Index"><i data-lucide="layout-grid"></i> আইনি বিভাগসমূহ</a>
                <a asp-controller="Case" asp-action="Track"><i data-lucide="folder-clock"></i> সকল মামলা রেকর্ড</a>
                <a asp-controller="Home" asp-action="About"><i data-lucide="info"></i> পরিচিতি ও দাবিত্যাগ</a>
            }
            else if (isLawyer)
            {
                <a asp-controller="Lawyer" asp-action="Queue"><i data-lucide="file-check-2"></i> আইনজীবী রিভিউ কিউ</a>
                <a asp-controller="Search" asp-action="Index"><i data-lucide="search"></i> আইন অনুসন্ধান ও রেফারেন্স</a>
                <a asp-controller="Category" asp-action="Index"><i data-lucide="layout-grid"></i> আইনি বিষয় ও বিভাগ</a>
                <a asp-controller="Case" asp-action="Track"><i data-lucide="folder-clock"></i> মামলা ট্র্যাকিং</a>
                <a asp-controller="Home" asp-action="About"><i data-lucide="info"></i> পরিচিতি ও দাবিত্যাগ</a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index"><i data-lucide="message-square"></i> আইনি সেবা ও চ্যাট</a>
                <a asp-controller="Case" asp-action="Submit"><i data-lucide="edit-3"></i> সমস্যা জমা দিন (Intake)</a>
                <a asp-controller="Case" asp-action="Track"><i data-lucide="folder-clock"></i> মামলা ট্র্যাকিং</a>
                <a asp-controller="Search" asp-action="Index"><i data-lucide="search"></i> আইন খুঁজুন</a>
                <a asp-controller="Category" asp-action="Index"><i data-lucide="layout-grid"></i> আইনি বিভাগসমূহ</a>
                <a asp-controller="Home" asp-action="About"><i data-lucide="info"></i> পরিচিতি ও দাবিত্যাগ</a>
            }
            
            <hr class="divider" style="margin:8px 0" />
            @if (!isAuthenticated)
            {
                <a asp-controller="Account" asp-action="Login"><i data-lucide="log-in"></i> সাইন ইন</a>
                <a asp-controller="Account" asp-action="Register"><i data-lucide="user-plus"></i> নতুন একাউন্ট নিবন্ধন</a>
            }
            else
            {
                <div style="padding: 4px 12px; font-size: 13px; color: var(--muted);">
                    সাইন ইন আছেন: <strong>@userDisplayName</strong>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="user-logout-form" style="margin: 4px 0;">
                    <button type="submit" class="user-logout-btn" style="background:none; border:none; width:100%; text-align:left; padding:8px 12px; font:inherit; font-size:14px; font-weight:600; color:var(--ink); display:flex; align-items:center; gap:10px; cursor:pointer;">
                        <i data-lucide="log-out"></i> লগআউট
                    </button>
                </form>
            }
        </nav>
        <div class="drawer-foot">
            <div class="row spread">
                <partial name="_LanguageToggle" />
                <button class="icon-btn theme-toggle" type="button" aria-label="থিম পরিবর্তন"></button>
            </div>
        </div>
    </aside>

    <!-- Main Page Content -->
    @RenderBody()

    <!-- ============ FOOTER ============ -->
    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-name">মুক্ত আইন<small>MuktoAin</small></span>
                </a>
                <p>বাংলাদেশের নাগরিকদের জন্য বিনামূল্যে AI-সহায়ক আইনি তথ্য — প্রতিটি দলিল যাচাইকৃত আইনজীবী দ্বারা পর্যালোচিত।</p>
            </div>
            <div>
                <h4>মেনু / Navigate</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">আইনি সেবা ও চ্যাট</a></li>
                    <li><a asp-controller="Category" asp-action="Index">আইনি বিষয়সমূহ</a></li>
                    <li><a asp-controller="Search" asp-action="Index">আইন অনুসন্ধান</a></li>
                    <li><a asp-controller="Case" asp-action="Track">মামলা ট্র্যাকিং</a></li>
                    <li><a asp-controller="Home" asp-action="About">আমাদের সম্পর্কে</a></li>
                </ul>
            </div>
            <div>
                <h4>আইনি / Legal</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="About" asp-fragment="disclaimer">পূর্ণাঙ্গ দাবিত্যাগ</a></li>
                    <li><a asp-controller="Home" asp-action="About" asp-fragment="faq">সাধারণ জিজ্ঞাসা (FAQ)</a></li>
                    <li><a asp-controller="Home" asp-action="About" asp-fragment="dataset">ডেটাসেট কৃতজ্ঞতা</a></li>
                </ul>
            </div>
            <div>
                <h4>ভূমিকা / Roles</h4>
                <ul>
                    <li><a asp-controller="Account" asp-action="Login">নাগরিক সাইন ইন</a></li>
                    <li><a asp-controller="Account" asp-action="Register">নতুন নিবন্ধন</a></li>
                    <li><a asp-controller="Lawyer" asp-action="Queue">আইনজীবী রিভিউ পোর্টাল</a></li>
                    <li><a asp-controller="Admin" asp-action="Dashboard">অ্যাডমিন ওভারভিউ</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            © 2026 মুক্ত আইন MuktoAin · AI-Augmented Legal Aid for Bangladesh · Academic Project · Not formal legal advice
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <script src="~/assets/js/main.js" asp-append-version="true"></script>

    @* Single place that surfaces TempData["Success"/"Info"/"Error"] as a toast, on
       whatever page the current redirect actually lands on. Reading the value here
       (via the C# indexer, once, every request) also consumes it -- so it can no
       longer leak forward, unread, onto an unrelated later page (see Case/Result and
       Account/Login history). Controllers should set the matching "*En" key too, so
       the toast follows the viewer's current language (localStorage "mkt-lang"). *@
    @{
        var toasts = new (string? Bn, string? En, string Type)[]
        {
            (TempData["Success"] as string, TempData["SuccessEn"] as string, "success"),
            (TempData["Info"] as string, TempData["InfoEn"] as string, "info"),
            (TempData["Error"] as string, TempData["ErrorEn"] as string, "error"),
        };
    }
    @foreach (var toast in toasts)
    {
        if (toast.Bn != null)
        {
            <script>
                (function () {
                    var lang = "bn";
                    try { lang = localStorage.getItem("mkt-lang") || "bn"; } catch (e) {}
                    var msg = lang === "en"
                        ? @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toast.En ?? toast.Bn))
                        : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toast.Bn));
                    document.addEventListener("DOMContentLoaded", function () {
                        if (typeof window.showToast === "function") window.showToast(msg, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toast.Type)));
                    });
                })();
            </script>
        }
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
