@{
    ViewData["Title"] = "পৃষ্ঠা পাওয়া যায়নি — 404";
}

<main class="container" id="main">
    <div class="error-wrap">
        <div class="error-code">404</div>
        <h1 class="page-title">পৃষ্ঠাটি খুঁজে পাওয়া যায়নি</h1>
        <p class="muted" data-bn="অনুরোধকৃত দলিল বা পৃষ্ঠাটি নেই বা সংরক্ষণাগারভুক্ত হয়েছে।" data-en="The requested legal document or page does not exist or has been archived.">The requested legal document or page does not exist or has been archived.</p>
        <div class="row wrap" style="justify-content: center; gap: 10px; margin-top: 10px;">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
                <i data-lucide="home"></i> <span data-bn="হোমে ফিরে যান" data-en="Back to Home">হোমে ফিরে যান</span>
            </a>
            <a class="btn btn-outline" asp-controller="Search" asp-action="Index">
                <i data-lucide="search"></i> <span data-bn="আইন অনুসন্ধান করুন" data-en="Search Statutes">আইন অনুসন্ধান করুন</span>
            </a>
        </div>
    </div>
</main>
