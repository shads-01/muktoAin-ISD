@{
    ViewData["Title"] = "প্রবেশাধিকার সংরক্ষিত — 403";
}

<main class="container" id="main">
    <div class="error-wrap">
        <div class="error-code">403</div>
        <h1 class="page-title">প্রবেশাধিকার সংরক্ষিত</h1>
        <p class="muted" data-bn="আপনার বর্তমান ভূমিকায় এই অ্যাডমিন বা আইনজীবী অংশে প্রবেশের অনুমতি নেই।" data-en="Your current role does not grant permission to access this administrative or lawyer area.">Your current role does not grant permission to access this administrative or lawyer area.</p>
        <div class="row wrap" style="justify-content: center; gap: 10px; margin-top: 10px;">
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">
                <i data-lucide="log-in"></i> <span data-bn="সাইন ইন করুন" data-en="Sign In">সাইন ইন করুন</span>
            </a>
            <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">
                <i data-lucide="home"></i> <span data-bn="হোমে ফিরুন" data-en="Back to Home">হোমে ফিরুন</span>
            </a>
        </div>
    </div>
</main>
