@model MuktoAin.Web.ViewModels.CategoryViewModel
@{
    ViewData["Title"] = $"{Model.NameBn} — Legal Category Details";
}

<main class="container" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="sep">/</span>
        <a asp-controller="Category" asp-action="Index" class="crumb-cat">বিভাগসমূহ</a>
        <span class="sep">/</span>
        <span class="crumb-cat-name" data-bn="@Model.NameBn" data-en="@Model.NameEn">@Model.NameBn</span>
    </nav>

    <div class="card card-pad-lg" style="margin-bottom: 24px;">
        <div class="row spread wrap" style="align-items: center; gap: 16px;">
            <div class="row" style="gap: 16px;">
                <span class="cat-icon-lg cat-icon"><i data-lucide="@Model.Icon"></i></span>
                <div>
                    <span class="kicker"><i data-lucide="tag"></i> Category ID #@Model.CategoryId</span>
                    <h1 class="page-title" style="margin-bottom: 2px;" data-bn="@Model.NameBn" data-en="@Model.NameEn">@Model.NameBn</h1>
                    <span class="cat-en" style="font-size: 14px;">@Model.NameEn</span>
                </div>
            </div>
            <a class="btn btn-primary btn-lg" asp-controller="Case" asp-action="Submit" asp-route-cat="@Model.CategoryId">
                <i data-lucide="edit-3"></i> <span class="cat-submit-text">এই বিভাগে মামলা দাখিল করুন</span>
            </a>
        </div>

        <hr class="divider" />

        <div class="stack" style="gap: 16px;">
            <div>
                <h3 class="cat-details-h" style="font-size: 17px; margin-bottom: 6px;">বিভাগের বিবরণ ও পরিধি</h3>
                <p class="cat-details-desc" style="font-size: 16px; line-height: 1.8;" data-bn="@Model.DescriptionBn" data-en="@Model.DescriptionEn">@Model.DescriptionBn</p>
            </div>

            @if (Model.CommonActions != null && Model.CommonActions.Count > 0)
            {
                <div style="background: var(--surface-2); padding: 18px; border-radius: var(--radius); border: 1px solid var(--border);">
                    <h4 class="cat-claims-h" style="font-size: 15px; margin-bottom: 10px;"><i data-lucide="check-square"></i> এই বিভাগে সচরাচর দাখিলযোগ্য অভিযোগসমূহ (ক্লিক করে চ্যাট শুরু করুন):</h4>
                    <div class="row wrap" style="gap: 8px; margin-top: 8px;">
                        @for (var i = 0; i < Model.CommonActions.Count; i++)
                        {
                            var enText = i < Model.CommonActionsEn.Count ? Model.CommonActionsEn[i] : Model.CommonActions[i];
                            var action = Model.CommonActions[i];
                            <a class="chip" asp-controller="Home" asp-action="Index"
                               asp-route-prefill="@action" data-bn="@action" data-en="@enText">@action</a>
                        }
                    </div>
                </div>
            }

        </div>
    </div>
</main>
