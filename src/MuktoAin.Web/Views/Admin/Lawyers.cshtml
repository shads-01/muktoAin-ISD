@model IEnumerable<MuktoAin.Web.ViewModels.AdminLawyerViewModel>
@{
    ViewData["Title"] = "আইনজীবী সনদ যাচাই — Admin Lawyers";
    ViewData["IsAdminPage"] = true;
    var pendingCount = Model.Count(a => string.Equals(a.VerificationStatus, "Pending", StringComparison.OrdinalIgnoreCase));
}

<main class="container" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index" data-bn="হোম" data-en="Home">Home</a>
        <span class="sep">/</span>
        <a asp-controller="Admin" asp-action="Dashboard" data-bn="অ্যাডমিন কনসোল" data-en="Admin Console">Admin Console</a>
        <span class="sep">/</span>
        <span data-bn="আইনজীবী সনদ যাচাই ট্রায়াজ" data-en="Lawyer Verification Triage">আইনজীবী সনদ যাচাই ট্রায়াজ</span>
    </nav>

    <div class="page-head">
        <span class="kicker" data-bn="FR-17 · Advocate Bar Verification Triage" data-en="FR-17 · Advocate Bar Verification Triage"><i data-lucide="award" aria-hidden="true"></i> FR-17 · Advocate Bar Verification Triage</span>
        <h1 class="page-title" data-bn="আইনজীবী বার সদন যাচাইকরণ" data-en="Lawyer Bar Credential Verification">আইনজীবী বার সদন যাচাইকরণ</h1>
        <p class="page-sub" data-bn="বার কাউন্সিল রেজিস্ট্রেশন নম্বর যাচাই করে আইনজীবীদের রিভিউ পারমিশন অনুমোদন বা বাতিল করুন।" data-en="Verify Bar Council registration numbers to approve or reject lawyer review permissions.">বার কাউন্সিল রেজিস্ট্রেশন নম্বর যাচাই করে আইনজীবীদের রিভিউ পারমিশন অনুমোদন বা বাতিল করুন।</p>
    </div>

    <div class="card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
            <div>
                <h2 style="font-size: 18px; margin: 0;"><i data-lucide="shield-check" style="display: inline; vertical-align: middle; color: var(--gold);"></i> <span data-bn="বার সনদ আবেদন কিউ" data-en="Bar Verification Queue">বার সনদ আবেদন কিউ</span></h2>
                <span class="muted tiny" data-bn="@pendingCount টি অপেক্ষমান আবেদন" data-en="@pendingCount pending applications">@pendingCount টি অপেক্ষমান আবেদন</span>
            </div>
            <span class="badge badge-gold" data-bn="@Model.Count() টি মোট আবেদন" data-en="@Model.Count() total applications">@Model.Count() টি মোট আবেদন</span>
        </div>

        <div class="table-wrap" style="overflow-x: auto;">
            <table class="table" style="width: 100%; font-size: 14px; text-align: left;">
                <thead>
                    <tr style="border-bottom: 1.5px solid var(--border);">
                        <th style="padding: 8px 10px;" data-bn="আইনজীবীর নাম" data-en="Applicant Name">আইনজীবীর নাম</th>
                        <th style="padding: 8px 10px;" data-bn="বার রেজিস্ট্রেশন নং" data-en="Bar Reg No">বার রেজিস্ট্রেশন নং</th>
                        <th style="padding: 8px 10px;" data-bn="বিশেষায়িত ক্ষেত্র" data-en="Specialization">বিশেষায়িত ক্ষেত্র</th>
                        <th style="padding: 8px 10px;" data-bn="যাচাই স্ট্যাটাস" data-en="Verification">যাচাই স্ট্যাটাস</th>
                        <th style="padding: 8px 10px;" data-bn="আবেদনের তারিখ" data-en="Applied">আবেদনের তারিখ</th>
                        <th style="padding: 8px 10px; text-align: right;" data-bn="সিদ্ধান্ত" data-en="Decision">সিদ্ধান্ত</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lawyer in Model)
                    {
                        var isPending = string.Equals(lawyer.VerificationStatus, "Pending", StringComparison.OrdinalIgnoreCase);
                        var isApproved = string.Equals(lawyer.VerificationStatus, "Approved", StringComparison.OrdinalIgnoreCase);
                        <tr style="border-bottom: 1px solid var(--border-soft);">
                            <td style="padding: 10px 10px; font-weight: 600;">@lawyer.ApplicantName</td>
                            <td style="padding: 10px 10px; font-family: monospace; font-weight: 700; color: #4a3812; white-space: nowrap;">@lawyer.BarRegistrationNumber</td>
                            <td style="padding: 10px 10px; font-size: 13px; color: var(--ink-2);">@(string.IsNullOrWhiteSpace(lawyer.Specialization) ? "—" : lawyer.Specialization)</td>
                            <td style="padding: 10px 10px;">
                                @if (isPending)
                                {
                                    <span class="badge badge-gold" style="color:#92743a;" data-bn="অপেক্ষমান (Pending)" data-en="Pending">অপেক্ষমান (Pending)</span>
                                }
                                else if (isApproved)
                                {
                                    <span class="badge badge-success" data-bn="যাচাইকৃত (Approved)" data-en="Approved">যাচাইকৃত (Approved)</span>
                                }
                                else
                                {
                                    <span class="badge badge-rejected" data-bn="বাতিল (Rejected)" data-en="Rejected">বাতিল (Rejected)</span>
                                }
                            </td>
                            <td style="padding: 10px 10px; font-size: 13px; color: var(--ink-2);">@lawyer.AppliedAt.ToString("dd MMM yyyy")</td>
                            <td style="padding: 10px 10px; text-align: right;">
                                @if (isPending)
                                {
                                    <div style="display: inline-flex; gap: 6px;">
                                        <form method="post" asp-controller="Admin" asp-action="Verify" asp-route-id="@lawyer.LawyerProfileId" asp-route-approve="true" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-primary btn-sm" style="min-height:44px; display:inline-flex; align-items:center; gap:6px; font-size:13px; padding:4px 10px;" data-bn="অনুমোদন" data-en="Approve">
                                                <i data-lucide="check" style="width: 15px; height: 15px;"></i> অনুমোদন
                                            </button>
                                        </form>
                                        <form method="post" asp-controller="Admin" asp-action="Verify" asp-route-id="@lawyer.LawyerProfileId" asp-route-approve="false" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline btn-sm" style="min-height:44px; display:inline-flex; align-items:center; gap:6px; font-size:13px; padding:4px 10px; color:#b91c1c;" data-bn="বাতিল" data-en="Reject">
                                                <i data-lucide="x" style="width: 15px; height: 15px;"></i> বাতিল
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="muted tiny" data-bn="ইতিমধ্যে সিদ্ধান্ত হয়েছে" data-en="Decision already recorded">ইতিমধ্যে সিদ্ধান্ত হয়েছে</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="muted tiny" style="margin-top: 16px;" data-bn="টীকা: বাংলাদেশ বার কাউন্সিল রেজিস্ট্রেশন নম্বর ক্রস-চেকের পরে সিদ্ধান্ত রেকর্ড হবে (LawyerVerificationService)।" data-en="Note: Bar Council number cross-check runs before the decision is recorded by LawyerVerificationService.">টীকা: বাংলাদেশ বার কাউন্সিল রেজিস্ট্রেশন নম্বর ক্রস-চেকের পরে সিদ্ধান্ত রেকর্ড হবে (LawyerVerificationService)।</div>
    </div>
</main>