@model MuktoAin.Web.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "অ্যাডমিন মিশন কন্ট্রোল — Admin Operations Hub";
    ViewData["IsAdminPage"] = true;
}

<main class="container" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">হোম</a>
        <span class="sep">/</span>
        <span>অ্যাডমিন কনসোল · মিশন কন্ট্রোল</span>
    </nav>

    <!-- Page Header with Operations Kicker -->
    <div class="page-head" style="margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap;">
            <div>
                <span class="kicker"><i data-lucide="shield-check" aria-hidden="true"></i> FR-15 · মিশন কন্ট্রোল ও সিস্টেম অপারেশনস</span>
                <h1 class="page-title" style="font-size: clamp(24px, 4vw, 32px);">অ্যাডমিন কন্ট্রোল হাব</h1>
                <p class="page-sub">প্ল্যাটফর্ম ইনফ্রাস্ট্রাকচার স্ট্যাটাস, আইনজীবী সনদ যাচাই ট্রায়াজ এবং সিস্টেম অ্যাকশন কনসোল।</p>
            </div>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <a asp-controller="Admin" asp-action="Analytics" class="btn btn-outline btn-sm">
                    <i data-lucide="bar-chart-3"></i> বিস্তারিত অ্যানালিটিক্স ও রিপোর্ট
                </a>
                <a asp-controller="Lawyer" asp-action="Queue" class="btn btn-outline btn-sm">
                    <i data-lucide="file-check-2"></i> আইনজীবী রিভিউ কিউ
                </a>
            </div>
        </div>
    </div>

    <!-- 1. Infrastructure Pulse Bar (Live System Health) -->
    <div class="card" style="margin-bottom: 24px; padding: 18px 22px; background: linear-gradient(135deg, rgba(255,253,247,0.98), rgba(248,242,228,0.95)); border: 1.5px solid #92743a;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px solid var(--border); padding-bottom: 8px;">
            <strong style="font-size: 14px; display: flex; align-items: center; gap: 8px; color: #4a3812;">
                <i data-lucide="server" style="width: 16px; height: 16px; color: var(--gold);"></i> লাইভ ইনফ্রাস্ট্রাকচার ও সার্ভিস পালস (System Health)
            </strong>
            <span class="badge badge-success" style="font-size: 12px; font-weight: 700;">সকল সার্ভিস সচল (Operational)</span>
        </div>
        <div class="grid grid-3" style="gap: 16px;">
            <div style="display: flex; align-items: center; gap: 12px; font-size: 13.5px;">
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #16a34a; display: inline-block; box-shadow: 0 0 8px #16a34a;"></span>
                <div>
                    <strong style="display: block;">MSSQL ডেটাবেস</strong>
                    <span class="muted tiny">@Model.DatabaseStatus</span>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 12px; font-size: 13.5px;">
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #16a34a; display: inline-block; box-shadow: 0 0 8px #16a34a;"></span>
                <div>
                    <strong style="display: block;">Qdrant ভেক্টর স্টোর (RAG)</strong>
                    <span class="muted tiny">@Model.VectorDbStatus</span>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 12px; font-size: 13.5px;">
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #16a34a; display: inline-block; box-shadow: 0 0 8px #16a34a;"></span>
                <div>
                    <strong style="display: block;">Gemini 2.5 Flash API</strong>
                    <span class="muted tiny">@Model.AiServiceStatus</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Operational KPI Cards -->
    <div class="grid grid-4" style="margin-bottom: 24px;">
        <div class="card kpi">
            <span class="k-label"><i data-lucide="user-check" aria-hidden="true"></i>সনদ যাচাই অপেক্ষমান</span>
            <span class="k-num" style="color: #92743a;">@Model.VerificationsWaiting</span>
            <span class="k-sub">বাংলাদেশ বার কাউন্সিল আইনজীবী আবেদন</span>
        </div>
        <div class="card kpi">
            <span class="k-label"><i data-lucide="clock" aria-hidden="true"></i>রিভিউ কিউ ব্যাকলগ</span>
            <span class="k-num" style="color: var(--primary);">@Model.PendingReviews</span>
            <span class="k-sub">আইনজীবী পর্যালোচনার অপেক্ষায়</span>
        </div>
        <div class="card kpi">
            <span class="k-label"><i data-lucide="book-marked" aria-hidden="true"></i>আইন ও স্ট্যাটিউট করপাস</span>
            <span class="k-num">@Model.TotalActsCount.ToString("N0")</span>
            <span class="k-sub">সম্পূর্ণ ডিজিটালাইজড আইন ভাণ্ডার</span>
        </div>
        <div class="card kpi">
            <span class="k-label"><i data-lucide="users" aria-hidden="true"></i>মোট প্ল্যাটফর্ম ব্যবহারকারী</span>
            <span class="k-num">@Model.TotalUsersCount</span>
            <span class="k-sub">নাগরিক ও আইনজীবী একাউন্ট</span>
        </div>
    </div>

    <!-- 3. Primary Operations Grid: Lawyer Verification Triage + Management Shortcuts -->
    <div class="grid grid-2" style="align-items: start; gap: 24px; margin-bottom: 24px;">
        
        <!-- Left: Lawyer Bar Verification Triage -->
        <div class="card" style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                <div>
                    <h2 style="font-size: 18px; margin: 0;"><i data-lucide="award" style="display: inline; vertical-align: middle; color: var(--gold);"></i> আইনজীবী সনদ যাচাই ট্রায়াজ (FR-17)</h2>
                    <span class="muted tiny">বার কাউন্সিল রেজিস্ট্রেশন নম্বর যাচাই করে অনুমোদন দিন</span>
                </div>
                <span class="badge badge-gold">@Model.VerificationQueue.Count টি অপেক্ষমান</span>
            </div>

            <div class="table-wrap" style="overflow-x: auto;">
                <table class="table" style="width: 100%; font-size: 14px; text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1.5px solid var(--border);">
                            <th style="padding: 8px 10px;">আবেদনকারীর নাম</th>
                            <th style="padding: 8px 10px;">বার রেজিস্ট্রেশন নং</th>
                            <th style="padding: 8px 10px;">তারিখ</th>
                            <th style="padding: 8px 10px; text-align: right;">সিদ্ধান্ত</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.VerificationQueue)
                        {
                            <tr style="border-bottom: 1px solid var(--border-soft);">
                                <td style="padding: 10px 10px; font-weight: 600;">@app.ApplicantName</td>
                                <td style="padding: 10px 10px; font-family: monospace; font-weight: 700; color: #4a3812;">@app.BarRegNo</td>
                                <td style="padding: 10px 10px; font-size: 13px; color: var(--ink-2);">@app.AppliedDate</td>
                                <td style="padding: 10px 10px; text-align: right;">
                                    <div style="display: inline-flex; gap: 6px;">
                                        <button class="btn btn-primary btn-sm" style="padding: 4px 8px; font-size: 12px;" title="অনুমোদন করুন">
                                            <i data-lucide="check" style="width: 13px; height: 13px;"></i> অনুমোদন
                                        </button>
                                        <button class="btn btn-outline btn-sm" style="padding: 4px 8px; font-size: 12px; color: #b91c1c;" title="বাতিল করুন">
                                            <i data-lucide="x" style="width: 13px; height: 13px;"></i> বাতিল
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div style="margin-top: 16px; text-align: right;">
                <a asp-controller="Search" asp-action="Index" class="btn btn-outline btn-sm" style="font-size: 12.5px;">
                    <i data-lucide="external-link"></i> সকল আইনজীবী অডিট রেকর্ড দেখুন
                </a>
            </div>
        </div>

        <!-- Right: Administrative Management Modules & Quick Tools -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            
            <!-- Management Hub Card -->
            <div class="card" style="padding: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">
                    <h2 style="font-size: 18px; margin: 0;"><i data-lucide="sliders" style="display: inline; vertical-align: middle; color: var(--gold);"></i> সিস্টেম ম্যানেজমেন্ট হাব</h2>
                </div>

                <div style="display: flex; flex-direction: column; gap: 12px;">
                    
                    <!-- 1. User & Role Management -->
                    <div style="border: 1px solid var(--border); padding: 14px 16px; border-radius: var(--radius-btn); background: var(--surface); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <strong style="font-size: 15px; display: block;"><i data-lucide="users" style="width: 16px; height: 16px; display: inline; vertical-align: text-bottom;"></i> ব্যবহারকারী ও রোল ব্যবস্থাপনা (FR-17)</strong>
                            <span class="muted tiny">নাগরিক ও আইনজীবী একাউন্ট সক্রিয়/স্থগিতকরণ ও অ্যাক্সেস নিয়ন্ত্রণ</span>
                        </div>
                        <a asp-controller="Search" asp-action="Index" class="btn btn-outline btn-sm">ম্যানেজ</a>
                    </div>

                    <!-- 2. Legislative Corpus & Indexing -->
                    <div style="border: 1px solid var(--border); padding: 14px 16px; border-radius: var(--radius-btn); background: var(--surface); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <strong style="font-size: 15px; display: block;"><i data-lucide="book-open-check" style="width: 16px; height: 16px; display: inline; vertical-align: text-bottom;"></i> আইন করপাস ও ভেক্টর রি-ইনডেক্সিং (FR-18)</strong>
                            <span class="muted tiny">১,৪৮৪টি আইন, সেকশন চাঙ্ক এবং SHA256 ইন্টিগ্রিটি রি-সিঙ্ক</span>
                        </div>
                        <a asp-controller="Search" asp-action="Index" class="btn btn-outline btn-sm">করপাস</a>
                    </div>

                    <!-- 3. Scenario Mappings & Legal Boosts -->
                    <div style="border: 1px solid var(--border); padding: 14px 16px; border-radius: var(--radius-btn); background: var(--surface); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <strong style="font-size: 15px; display: block;"><i data-lucide="zap" style="width: 16px; height: 16px; display: inline; vertical-align: text-bottom;"></i> সিনারিও কি-ওয়ার্ড বুস্ট ম্যাপিং (FR-18)</strong>
                            <span class="muted tiny">আইনি সমস্যার ধরন ও সেকশন র্যাংকিং বুস্টিং রুলস</span>
                        </div>
                        <a asp-controller="Category" asp-action="Index" class="btn btn-outline btn-sm">কনফিগার</a>
                    </div>

                    <!-- 4. Deep Analytics Suite -->
                    <div style="border: 1px solid var(--border); padding: 14px 16px; border-radius: var(--radius-btn); background: var(--surface); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <strong style="font-size: 15px; display: block;"><i data-lucide="pie-chart" style="width: 16px; height: 16px; display: inline; vertical-align: text-bottom;"></i> প্ল্যাটফর্ম অ্যানালিটিক্স ও প্রভাব রিপোর্ট (FR-16)</strong>
                            <span class="muted tiny">৬৪ জেলাভিত্তিক আইনি চাহিদার চার্ট ও কনভার্সন ফানেল</span>
                        </div>
                        <a asp-controller="Admin" asp-action="Analytics" class="btn btn-primary btn-sm">অ্যানালিটিক্স</a>
                    </div>
                </div>
            </div>

            <!-- Emergency Safety & Maintenance Card -->
            <div class="card" style="padding: 18px 22px; background: rgba(146, 116, 56, 0.06); border: 1px dashed var(--gold);">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <strong style="font-size: 14px; color: #4a3812; display: block;"><i data-lucide="alert-triangle" style="width: 15px; height: 15px; display: inline;"></i> রেট লিমিট ও ব্যাকলগ মনিটর</strong>
                        <span class="muted tiny">গুগল এআই স্টুডিও ফ্রি-টিয়ার কোটা স্বাস্থ্য স্বাভাবিক (১৫ আরপিএম নিরাপদ)</span>
                    </div>
                    <span class="badge badge-success">কোটা নিরাপদ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Live System Audit & Security Event Stream -->
    <div class="card" style="padding: 24px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">
            <div>
                <h2 style="font-size: 18px; margin: 0;"><i data-lucide="history" style="display: inline; vertical-align: middle; color: var(--gold);"></i> সাম্প্রতিক সিস্টেম অডিট ও সিকিউরিটি লগ</h2>
                <span class="muted tiny">প্ল্যাটফর্মের গুরুত্বপূর্ণ প্রশাসনিক ও স্বয়ংক্রিয় অ্যাকশন রেকর্ডসমূহ</span>
            </div>
            <span class="badge badge-primary">লাইভ অডিট ট্রেইল</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px;">
            @foreach (var log in Model.AuditLogs)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: var(--surface-2); border-radius: var(--radius-btn); font-size: 13.5px; flex-wrap: wrap; gap: 8px;">
                    <div style="display: flex; align-items: center; gap: 12px; min-width: 280px;">
                        @if (log.Status == "Success")
                        {
                            <span class="badge badge-success" style="font-size: 11px;">সফল</span>
                        }
                        else if (log.Status == "Warning")
                        {
                            <span class="badge badge-gold" style="font-size: 11px;">সতর্কতা</span>
                        }
                        else
                        {
                            <span class="badge badge-info" style="font-size: 11px;">তথ্য</span>
                        }
                        <div>
                            <strong>@log.Action</strong>
                            <span class="muted tiny" style="display: block;">@log.Details</span>
                        </div>
                    </div>
                    <div style="font-size: 12.5px; color: var(--ink-2); text-align: right;">
                        <span>দ্বারা: <b>@log.Actor</b></span> · <span>@log.Timestamp</span>
                    </div>
                </div>
            }
        </div>
    </div>
</main>
