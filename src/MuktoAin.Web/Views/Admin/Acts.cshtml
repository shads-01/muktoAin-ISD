@model IEnumerable<MuktoAin.Web.ViewModels.AdminActViewModel>
@{
    ViewData["Title"] = "আইন করপাস ব্যবস্থাপনা — Admin Acts";
    ViewData["IsAdminPage"] = true;
}

<main class="container" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index" data-bn="হোম" data-en="Home">Home</a>
        <span class="sep">/</span>
        <a asp-controller="Admin" asp-action="Dashboard" data-bn="অ্যাডমিন কনসোল" data-en="Admin Console">Admin Console</a>
        <span class="sep">/</span>
        <span data-bn="আইন করপাস ও ভেক্টর রি-ইনডেক্সিং" data-en="Acts Corpus & Re-indexing">আইন করপাস ও ভেক্টর রি-ইনডেক্সিং</span>
    </nav>

    <div class="page-head">
        <span class="kicker" data-bn="FR-18 · Legislative Corpus & Vector Re-indexing" data-en="FR-18 · Legislative Corpus & Vector Re-indexing"><i data-lucide="book-open-check" aria-hidden="true"></i> FR-18 · Legislative Corpus &amp; Vector Re-indexing</span>
        <h1 class="page-title" data-bn="আইন করপাস ও ইমবেডিং স্ট্যাটাস" data-en="Acts Corpus & Embedding Status">আইন করপাস ও ইমবেডিং স্ট্যাটাস</h1>
        <p class="page-sub" data-bn="১,৪৮৪টি আইনের সেকশন কাউন্ট, সর্বশেষ ইমপোর্ট তারিখ এবং Qdrant রি-ইনডেক্সিং ট্রিগার।" data-en="Section counts, last import dates, and Qdrant re-indexing triggers across the statute corpus.">১,৪৮৪টি আইনের সেকশন কাউন্ট, সর্বশেষ ইমপোর্ট তারিখ এবং Qdrant রি-ইনডেক্সিং ট্রিগার।</p>
    </div>

    <div class="card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
            <div>
                <h2 style="font-size: 18px; margin: 0;"><i data-lucide="library" style="display: inline; vertical-align: middle; color: var(--gold);"></i> <span data-bn="আইন তালিকা ও অর্নিয়েন্টেশন স্ট্যাটাস" data-en="Acts List & Indexing Status">আইন তালিকা ও অর্নিয়েন্টেশন স্ট্যাটাস</span></h2>
                <span class="muted tiny" data-bn="@Model.Count() টি আংশিক কোরপাস প্রিভিউ (মোট ১,৪৮৪)" data-en="@Model.Count() corpus preview rows (of 1,484 total)">@Model.Count() টি আংশিক কোরপাস প্রিভিউ (মোট ১,৪৮৪)</span>
            </div>
            <span class="badge badge-info" data-bn="@Model.Count(a => !a.IsVectorIndexed) টি রি-ইনডেক্স অপেক্ষমান" data-en="@Model.Count(a => !a.IsVectorIndexed) awaiting re-index">@Model.Count(a => !a.IsVectorIndexed) টি রি-ইনডেক্স অপেক্ষমান</span>
        </div>

        <div class="table-wrap" style="overflow-x: auto;">
            <table class="table" style="width: 100%; font-size: 14px; text-align: left;">
                <thead>
                    <tr style="border-bottom: 1.5px solid var(--border);">
                        <th style="padding: 8px 10px;" data-bn="আইনের শিরোনাম" data-en="Act Title">আইনের শিরোনাম</th>
                        <th style="padding: 8px 10px;" data-bn="সাল" data-en="Year">সাল</th>
                        <th style="padding: 8px 10px; text-align: center;" data-bn="সেকশন সংখ্যা" data-en="Sections">সেকশন সংখ্যা</th>
                        <th style="padding: 8px 10px;" data-bn="সর্বশেষ ইমপোর্ট" data-en="Last Import">সর্বশেষ ইমপোর্ট</th>
                        <th style="padding: 8px 10px;" data-bn="ইমবেডিং স্ট্যাটাস" data-en="Embedding">ইমবেডিং স্ট্যাটাস</th>
                        <th style="padding: 8px 10px; text-align: right;" data-bn="রি-ইনডেক্স" data-en="Re-index">রি-ইনডেক্স</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var act in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--border-soft);">
                            <td style="padding: 10px 10px; font-weight: 600; min-width: 260px;">@act.Title</td>
                            <td style="padding: 10px 10px; font-size: 13px; color: var(--ink-2);">@act.Year</td>
                            <td style="padding: 10px 10px; text-align: center; font-family: monospace; font-weight: 700;">@act.SectionCount</td>
                            <td style="padding: 10px 10px; font-size: 13px; color: var(--ink-2); white-space: nowrap;">@act.ImportedAt.ToString("dd MMM yyyy")</td>
                            <td style="padding: 10px 10px;">
                                @if (act.IsVectorIndexed)
                                {
                                    <span class="badge badge-success" data-bn="Qdrant-এ সূচিত" data-en="Indexed in Qdrant">Qdrant-এ সূচিত</span>
                                }
                                else
                                {
                                    <span class="badge badge-gold" style="color:#92743a;" data-bn="সূচিত নয় (Fallback FTS)" data-en="Not indexed (FTS fallback)">সূচিত নয় (Fallback FTS)</span>
                                }
                            </td>
                            <td style="padding: 10px 10px; text-align: right;">
                                <form method="post" asp-controller="Admin" asp-action="Reindex" asp-route-id="@act.ActId" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline btn-sm" style="min-height:44px; display:inline-flex; align-items:center; gap:6px; font-size:13px; padding:4px 10px;" data-bn="রি-ইনডেক্স" data-en="Re-index">
                                        <i data-lucide="refresh-cw" style="width: 15px; height: 15px;"></i> রি-ইনডেক্স
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="muted tiny" style="margin-top: 16px;" data-bn="টীকা: রি-ইনডেক্স SHA256 চেকসাম মিলিয়ে শুধু পরিবর্তিত চাঙ্কগুলো আপডেট করবে (ActsManagementService + EmbeddingBatchJob)।" data-en="Note: Re-index compares SHA256 checksums and re-embeds only changed chunks (ActsManagementService + EmbeddingBatchJob).">টীকা: রি-ইনডেক্স SHA256 চেকসাম মিলিয়ে শুধু পরিবর্তিত চাঙ্কগুলো আপডেট করবে (ActsManagementService + EmbeddingBatchJob)।</div>
    </div>
</main>