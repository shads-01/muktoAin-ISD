@model MuktoAin.Web.ViewModels.CreateAdminViewModel
@{
    ViewData["Title"] = "Create Admin — MuktoAin";
    ViewData["IsAdminPage"] = true;
}

<main class="container" id="main" style="max-width: 560px;">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
        <span class="sep">/</span>
        <a asp-controller="Admin" asp-action="Users">Users</a>
        <span class="sep">/</span>
        <span>Create Admin</span>
    </nav>

    <div class="page-head">
        <h1 class="page-title">Create Admin</h1>
        <p class="page-sub">SuperAdmin only. A random password is generated and a reset link is shown below — relay it to the new admin out-of-band.</p>
    </div>

    <div class="card" style="padding: 24px; border-radius: 8px;">
        <div style="background: rgba(var(--primary-rgb, 92, 71, 21), 0.08); border-left: 4px solid var(--primary, #5c4715); padding: 12px 16px; border-radius: 4px; margin-bottom: 20px; font-size: 0.9rem; line-height: 1.5;">
            <strong>ℹ️ পাসওয়ার্ড সংক্রান্ত তথ্য / Password Notice:</strong><br />
            নিরাপত্তার স্বার্থে নতুন অ্যাডমিনের জন্য সিস্টেম স্বয়ংক্রিয়ভাবে একটি শক্তিশালী পাসওয়ার্ড তৈরি করবে। অ্যাকাউন্ট তৈরির পর একটি ওয়ান-টাইম পাসওয়ার্ড রিসেট লিংক স্ক্রিনে দেখানো হবে, যা নতুন অ্যাডমিনকে প্রদান করবেন।
        </div>

        <form asp-action="CreateAdmin" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger" style="margin-bottom: 16px; font-size: 0.9rem;"></div>

            <div class="form-group" style="margin-bottom: 16px;">
                <label asp-for="FullName" style="display: block; margin-bottom: 6px; font-weight: 600;">পূর্ণ নাম / Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="e.g. Adv. Mahadi Hasan" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border, #ccc); border-radius: 4px;" />
                <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.85rem;"></span>
            </div>

            <div class="form-group" style="margin-bottom: 16px;">
                <label asp-for="Email" style="display: block; margin-bottom: 6px; font-weight: 600;">ইমেইল / Email</label>
                <input asp-for="Email" class="form-control" placeholder="e.g. admin.tultul@muktoain.bd" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border, #ccc); border-radius: 4px;" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.85rem;"></span>
            </div>

            <div class="form-group" style="margin-top: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <input asp-for="AsSuperAdmin" type="checkbox" id="AsSuperAdminCheck" style="width: 18px; height: 18px; cursor: pointer;" />
                <label for="AsSuperAdminCheck" style="cursor: pointer; font-weight: 500; margin-bottom: 0;">
                    সুপার অ্যাডমিন ক্ষমতা প্রদান করুন / Grant SuperAdmin Privileges
                </label>
            </div>

            <button type="submit" class="btn btn-primary" style="padding: 8px 20px; cursor: pointer;">নতুন অ্যাডমিন তৈরি করুন / Create Admin</button>
        </form>
    </div>
</main>
