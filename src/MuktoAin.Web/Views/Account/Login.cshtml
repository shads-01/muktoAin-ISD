@model MuktoAin.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "সাইন ইন — Login";
}

<main id="main">
    <div class="auth-split">
        <!-- Side Branding Column (Desktop) -->
        <div class="auth-side">
            <span class="kicker"><i data-lucide="shield-check"></i> Secure Legal Portal</span>
            <h2>নাগরিকের আইনি ক্ষমতায়নে মুক্ত আইন</h2>
            <ul>
                <li>
                    <i data-lucide="check-circle-2"></i>
                    <span>সহজ ভাষায় আপনার যেকোনো আইনি সমস্যার তাৎক্ষণিক পর্যালোচনা ও অধিকারের ব্যাখ্যা।</span>
                </li>
                <li>
                    <i data-lucide="check-circle-2"></i>
                    <span>স্বয়ংক্রিয় জিডি, আরটিআই এবং শ্রম-ভোক্তা অভিযোগের খসড়া তৈরি।</span>
                </li>
                <li>
                    <i data-lucide="check-circle-2"></i>
                    <span>বাংলাদেশ বার কাউন্সিলের সনদপ্রাপ্ত আইনজীবী কর্তৃক প্রতিটি দলিলের বাধ্যতামূলক সত্যায়ন।</span>
                </li>
                <li>
                    <i data-lucide="check-circle-2"></i>
                    <span>সম্পূর্ণ বিনামূল্যে, আধুনিক এনক্রিপশন ও নাগরিক তথ্যের গোপনীয়তা সুরক্ষা।</span>
                </li>
            </ul>
            <div class="tiny muted" style="margin-top: 1rem;">
                © 2026 মুক্ত আইন · Not formal legal advice
            </div>
        </div>

        <!-- Form Column -->
        <div class="auth-form-wrap">
            <div class="auth-card card card-pad-lg">
                <nav class="breadcrumbs" aria-label="Breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <span class="sep">/</span>
                    <span>সাইন ইন</span>
                </nav>

                <div class="page-head" style="margin-bottom: 20px;">
                    <span class="kicker"><i data-lucide="log-in"></i> Authentication</span>
                    <h1 class="page-title" style="font-size: 26px;">আপনার একাউন্টে প্রবেশ করুন</h1>
                    <p class="page-sub">মামলার অগ্রগতি দেখতে বা আইনজীবী রিভিউ করতে লগইন করুন</p>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" style="margin-bottom: 16px;">
                        <i data-lucide="check-circle-2"></i>
                        <div>@TempData["Success"]</div>
                    </div>
                }
                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info" style="margin-bottom: 16px;">
                        <i data-lucide="info"></i>
                        <div>@TempData["Info"]</div>
                    </div>
                }

                <div class="demo-accounts-card" style="margin-bottom: 20px; padding: 14px 16px; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius);">
                    <div class="row spread" style="align-items: center; margin-bottom: 10px;">
                        <span class="tiny" style="font-weight: 700; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.05em; display: inline-flex; align-items: center; gap: 6px;">
                            <i data-lucide="zap" style="width: 14px; height: 14px; color: var(--primary);"></i> <span class="demo-quick-title">ডেমো একাউন্ট টেস্ট করুন · Quick Demo Fill</span>
                        </span>
                        <span class="badge badge-neutral tiny" style="font-size: 11px;">1-Click Fill</span>
                    </div>
                    <div class="demo-btn-group" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                        <button type="button" class="btn btn-sm btn-outline demo-btn" onclick="fillDemo('citizen@muktoain.bd', 'Citizen@123', 'Citizen')" style="font-size: 12.5px; padding: 7px 6px; justify-content: center;">
                            <i data-lucide="user" style="width: 13px; height: 13px;"></i> <span class="demo-role-citizen">নাগরিক</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline demo-btn" onclick="fillDemo('lawyer@muktoain.bd', 'Lawyer@123', 'Lawyer')" style="font-size: 12.5px; padding: 7px 6px; justify-content: center;">
                            <i data-lucide="award" style="width: 13px; height: 13px;"></i> <span class="demo-role-lawyer">আইনজীবী</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline demo-btn" onclick="fillDemo('admin@muktoain.bd', 'muktoAin@123', 'Admin')" style="font-size: 12.5px; padding: 7px 6px; justify-content: center;">
                            <i data-lucide="shield-check" style="width: 13px; height: 13px;"></i> <span class="demo-role-admin">অ্যাডমিন</span>
                        </button>
                    </div>
                </div>

                <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="alert alert-warn" style="margin-bottom: 16px;"></div>

                    <div class="field">
                        <label asp-for="Email">ইমেইল ঠিকানা / Email</label>
                        <input asp-for="Email" class="input" type="email" placeholder="name@example.com" required autocomplete="username" />
                        <span asp-validation-for="Email" class="err"></span>
                    </div>

                    <div class="field">
                        <div class="row spread">
                            <label asp-for="Password">পাসওয়ার্ড / Password</label>
                            <a href="#" class="tiny muted" onclick="showToast('পাসওয়ার্ড রিসেট লিংক আপনার ইমেইলে পাঠানো হয়েছে (ডেমো)', 'info'); return false;">পাসওয়ার্ড ভুলে গেছেন?</a>
                        </div>
                        <input asp-for="Password" class="input" type="password" placeholder="••••••••" required autocomplete="current-password" />
                        <span asp-validation-for="Password" class="err"></span>
                    </div>

                    <div class="field" style="margin-bottom: 20px;">
                        <label class="check-row" for="rememberMe">
                            <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                            <span>আমাকে মনে রাখুন (Remember Me)</span>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg btn-block">
                        <i data-lucide="log-in"></i> সাইন ইন করুন / Sign In
                    </button>
                </form>

                <hr class="divider" />

                <div class="text-center" style="font-size: 14px; text-align: center;">
                    নতুন ব্যবহারকারী? <a asp-controller="Account" asp-action="Register" style="font-weight: 700;">নতুন একাউন্ট নিবন্ধন করুন →</a>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        function fillDemo(email, pass, role) {
            var emailInput = document.querySelector('input[name="Email"]');
            var passInput = document.querySelector('input[name="Password"]');
            if (emailInput && passInput) {
                emailInput.value = email;
                passInput.value = pass;
                
                emailInput.style.transition = 'all 0.3s ease';
                passInput.style.transition = 'all 0.3s ease';
                emailInput.style.borderColor = 'var(--primary)';
                passInput.style.borderColor = 'var(--primary)';
                setTimeout(function() {
                    emailInput.style.borderColor = '';
                    passInput.style.borderColor = '';
                }, 1200);

                var lang = localStorage.getItem("mkt-lang") || "bn";
                var roleName = role === "Citizen" ? (lang === "en" ? "Citizen" : "নাগরিক") 
                             : role === "Lawyer" ? (lang === "en" ? "Lawyer" : "আইনজীবী") 
                             : (lang === "en" ? "Admin" : "অ্যাডমিন");
                var msg = lang === "en" 
                    ? "Demo " + roleName + " credentials filled: " + email 
                    : "ডেমো " + roleName + " তথ্য স্বয়ংক্রিয়ভাবে পূরণ করা হয়েছে (" + email + ")";
                if (typeof showToast === "function") {
                    showToast(msg, "success");
                }
            }
        }
    </script>
}
