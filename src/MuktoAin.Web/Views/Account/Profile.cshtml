@model MuktoAin.Web.ViewModels.ProfileViewModel
@using MuktoAin.Application.Services
@inject AiBudgetService Budget
@{
    ViewData["Title"] = "ব্যবহারকারী প্রোফাইল ও সেটিংস — User Profile";
    var isLawyer = string.Equals(Model.Role, "Lawyer", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(Model.Role, "Admin", StringComparison.OrdinalIgnoreCase);
    var isCitizen = !isLawyer && !isAdmin;
    var roleBn = isAdmin ? "সিস্টেম অ্যাডমিনিস্ট্রেটর" : isLawyer ? "আইনজীবী" : "সাধারণ নাগরিক";
    var roleEn = isAdmin ? "System Administrator" : isLawyer ? "Advocate" : "Citizen";

    var initial = "U";
    if (!string.IsNullOrWhiteSpace(Model.FullName))
    {
        initial = Model.FullName.Trim().Substring(0, 1).ToUpperInvariant();
    }

    // Chat quota + paid chat credits, read here so every re-render of this
    // view (including failed form posts, which do not post UserId) shows the
    // live balance. The page is [Authorize], so the claim is always there.
    var signedInUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
    var quota = await Budget.GetRemainingToday(signedInUserId, null);
}

<main class="container" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">হোম</a>
        <span class="sep">/</span>
        <span>অ্যাকাউন্ট প্রোফাইল</span>
    </nav>

    <!-- Profile Hero Card -->
    <div class="card" style="margin-bottom: 24px; padding: 28px; background: linear-gradient(135deg, var(--surface), var(--surface-2)); border: 1px solid var(--border);">
        <div style="display: flex; align-items: center; gap: 24px; flex-wrap: wrap;">
            <div class="avatar" style="width: 76px; height: 76px; font-size: 30px; font-weight: 800; border: 2.5px solid var(--gold); box-shadow: 0 4px 14px rgba(146, 116, 56, 0.2);">
                @initial
            </div>
            <div style="flex: 1; min-width: 240px;">
                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 6px;">
                    <h1 style="font-size: clamp(22px, 4vw, 30px); margin: 0; line-height: 1.2;">@Model.FullName</h1>
                    @if (isAdmin)
                    {
                        <span class="badge badge-success" style="font-size: 13px; padding: 4px 10px;"><i data-lucide="shield" style="width: 14px; height: 14px; display: inline;"></i> <span data-bn="সিস্টেম অ্যাডমিনিস্ট্রেটর" data-en="System Administrator">সিস্টেম অ্যাডমিনিস্ট্রেটর</span></span>
                    }
                    else if (isLawyer)
                    {
                        <span class="badge badge-gold" style="font-size: 13px; padding: 4px 10px;"><i data-lucide="award" style="width: 14px; height: 14px; display: inline;"></i> <span data-bn="বাংলাদেশ বার কাউন্সিল আইনজীবী" data-en="Bangladesh Bar Council Advocate">বাংলাদেশ বার কাউন্সিল আইনজীবী</span></span>
                    }
                    else
                    {
                        <span class="badge badge-primary" style="font-size: 13px; padding: 4px 10px;"><i data-lucide="user-check" style="width: 14px; height: 14px; display: inline;"></i> <span data-bn="নিবন্ধিত নাগরিক" data-en="Registered Citizen">নিবন্ধিত নাগরিক</span></span>
                    }
                </div>
                <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap; color: var(--ink-2); font-size: 14px;">
                    <span><i data-lucide="mail" style="width: 15px; height: 15px; display: inline; vertical-align: text-bottom;"></i> @Model.Email</span>
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentPhoneNumber))
                    {
                        <span><i data-lucide="phone" style="width: 15px; height: 15px; display: inline; vertical-align: text-bottom;"></i> @Model.CurrentPhoneNumber</span>
                    }
                    <span><i data-lucide="calendar" style="width: 15px; height: 15px; display: inline; vertical-align: text-bottom;"></i> <span data-bn="সদস্য পদ:" data-en="Member since:">সদস্য পদ:</span> @Model.CreatedAt.ToString("dd MMM yyyy")</span>
                    <span><span class="badge badge-success" style="font-size: 11px;"><span data-bn="স্ট্যাটাস:" data-en="Status:">স্ট্যাটাস:</span> @if (Model.AccountStatus == "Active") { <span data-bn="সক্রিয়" data-en="Active">সক্রিয়</span> } else { <text>@Model.AccountStatus</text> }</span></span>
                </div>
            </div>
        </div>
    </div>

    <!-- AI chat credits (FR-24 top-up) — citizens only, like PaymentController.TopUp -->
    @if (isCitizen)
    {
    <div class="card" style="margin-bottom: 24px; padding: 20px 24px;" data-testid="chat-credits-card">
        <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 220px;">
                <h2 style="font-size: 17px; margin: 0 0 4px;"><i data-lucide="zap" style="display: inline; vertical-align: middle; color: var(--gold);"></i> <span data-bn="AI চ্যাট ক্রেডিট" data-en="AI Chat Credits">AI চ্যাট ক্রেডিট</span></h2>
                <div style="display: flex; gap: 16px; flex-wrap: wrap; color: var(--ink-2); font-size: 14px;">
                    <span><span data-bn="ক্রেডিট:" data-en="Credits:">ক্রেডিট:</span> <b data-testid="chat-credits-balance">@quota.Credits</b></span>
                    <span><span data-bn="আজকের বিনামূল্যের চ্যাট বাকি:" data-en="Free chats left today:">আজকের বিনামূল্যের চ্যাট বাকি:</span> <b>@quota.RemainingToday / @quota.DailyLimit</b></span>
                </div>
                <p class="muted tiny" style="margin: 6px 0 0;" data-bn="দৈনিক বিনামূল্যের চ্যাট শেষ হলে ক্রেডিট খরচ হয়। ক্রেডিটের মেয়াদ শেষ হয় না।" data-en="Credits are used after your free daily chats run out. They never expire.">দৈনিক বিনামূল্যের চ্যাট শেষ হলে ক্রেডিট খরচ হয়। ক্রেডিটের মেয়াদ শেষ হয় না।</p>
            </div>
            <button class="btn btn-gold" type="button" data-open-modal="#topup-modal">
                <i data-lucide="credit-card"></i> <span data-bn="রিচার্জ করুন" data-en="Recharge">রিচার্জ করুন</span>
            </button>
        </div>
    </div>
    }

    <!-- Main Grid: Info Form + Security / Actions -->
    <div class="grid grid-2" style="align-items: start; gap: 24px;">
        
        <!-- Left: Editable & Uneditable Profile Information -->
        <div class="card" style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                <h2 style="font-size: 19px; margin: 0;"><i data-lucide="user-cog" style="display: inline; vertical-align: middle; color: var(--gold);"></i> <span data-bn="প্রোফাইল ও অ্যাকাউন্ট তথ্য" data-en="Profile &amp; Account Details">প্রোফাইল ও অ্যাকাউন্ট তথ্য</span></h2>
                <span class="muted tiny" data-bn="সবুজ ফিল্ডগুলো সম্পাদনাযোগ্য" data-en="Green fields are editable">সবুজ ফিল্ডগুলো সম্পাদনাযোগ্য</span>
            </div>

            <form asp-controller="Account" asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-error" style="margin-bottom: 16px;"></div>

                <!-- Uneditable: Email -->
                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label" style="display: flex; justify-content: space-between;">
                        <span data-bn="লগইন ইমেইল" data-en="Login Email">লগইন ইমেইল</span>
                        <span class="muted tiny" style="color: var(--primary);"><i data-lucide="lock" style="width: 12px; height: 12px; display: inline;"></i> <span data-bn="পরিবর্তনযোগ্য নয়" data-en="Not editable">পরিবর্তনযোগ্য নয়</span></span>
                    </label>
                    <input type="email" class="form-control" value="@Model.Email" readonly disabled style="background: rgba(0,0,0,0.04); cursor: not-allowed; font-family: monospace;" />
                </div>

                <!-- Uneditable: Role -->
                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label" style="display: flex; justify-content: space-between;">
                        <span data-bn="অ্যাকাউন্ট ভূমিকা" data-en="Account Role">অ্যাকাউন্ট ভূমিকা</span>
                        <span class="muted tiny" style="color: var(--primary);"><i data-lucide="shield-check" style="width: 12px; height: 12px; display: inline;"></i> <span data-bn="সিস্টেম নিয়ন্ত্রিত" data-en="System managed">সিস্টেম নিয়ন্ত্রিত</span></span>
                    </label>
                    <input type="text" class="form-control" value="@roleBn" data-bn-value="@roleBn" data-en-value="@roleEn" readonly disabled style="background: rgba(0,0,0,0.04); cursor: not-allowed;" />
                </div>

                <!-- Lawyer-Specific Uneditable Credentials -->
                @if (isLawyer)
                {
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label class="form-label" style="display: flex; justify-content: space-between;">
                            <span data-bn="বার কাউন্সিল সনদ নম্বর" data-en="Bar Registration No.">বার কাউন্সিল সনদ নম্বর</span>
                            <span class="muted tiny" style="color: var(--primary);"><i data-lucide="award" style="width: 12px; height: 12px; display: inline;"></i> <span data-bn="যাচাইকৃত রেকর্ড" data-en="Verified record">যাচাইকৃত রেকর্ড</span></span>
                        </label>
                        <input type="text" class="form-control" value="@Model.BarRegistrationNumber" readonly disabled style="background: rgba(0,0,0,0.04); cursor: not-allowed; font-weight: 700; color: #4a3812;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 16px;">
                        <label class="form-label" data-bn="অ্যাডমিন ভেরিফিকেশন স্ট্যাটাস" data-en="Admin Verification Status">অ্যাডমিন ভেরিফিকেশন স্ট্যাটাস</label>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            @if (Model.VerificationStatus == "Verified" || Model.VerificationStatus == "Approved")
                            {
                                <span class="badge badge-success"><i data-lucide="check-circle" style="width: 14px; height: 14px; display: inline;"></i> <span data-bn="যাচাইকরণ সম্পন্ন" data-en="Verified by Admin">যাচাইকরণ সম্পন্ন</span></span>
                            }
                            else
                            {
                                <span class="badge badge-gold"><i data-lucide="clock" style="width: 14px; height: 14px; display: inline;"></i> <span data-bn="পর্যালোচনার অপেক্ষায়" data-en="Pending Verification">পর্যালোচনার অপেক্ষায়</span></span>
                            }
                        </div>
                    </div>
                }

                <hr class="divider" style="margin: 20px 0;" />

                <!-- Editable: Full Name -->
                <div class="form-group" style="margin-bottom: 16px;">
                    <label asp-for="FullName" class="form-label"><span data-bn="পূর্ণ নাম" data-en="Full Name">পূর্ণ নাম</span> <span style="color: var(--primary);">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="আপনার পূর্ণ নাম লিখুন" data-bn-placeholder="আপনার পূর্ণ নাম লিখুন" data-en-placeholder="Enter your full name" required />
                    <span asp-validation-for="FullName" class="text-danger" style="font-size: 13px;"></span>
                </div>

                <!-- Editable: Phone Number -->
                <div class="form-group" style="margin-bottom: 16px;">
                    <label asp-for="PhoneNumber" class="form-label" data-bn="মোবাইল / ফোন নম্বর" data-en="Mobile / Phone Number">মোবাইল / ফোন নম্বর</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="০১XXXXXXXXX" data-bn-placeholder="০১XXXXXXXXX" data-en-placeholder="01XXXXXXXXX" />
                    <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size: 13px;"></span>
                </div>

                <!-- Lawyer-Specific Editable Fields -->
                @if (isLawyer)
                {
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label asp-for="Specialization" class="form-label" data-bn="বিশেষজ্ঞতার ক্ষেত্র" data-en="Legal Specialization">বিশেষজ্ঞতার ক্ষেত্র</label>
                        <input asp-for="Specialization" class="form-control" placeholder="উদাঃ শ্রম আইন, ফৌজদারি, দেওয়ানি, ভোক্তা অধিকার" data-bn-placeholder="উদাঃ শ্রম আইন, ফৌজদারি, দেওয়ানি, ভোক্তা অধিকার" data-en-placeholder="e.g. Labour, Criminal, Civil, Consumer Rights" />
                        <span class="muted tiny" data-bn="উদাঃ শ্রম আইন, ফৌজদারি ও সাইবার নিরাপত্তা, ইত্যাদি" data-en="e.g. Labour Law, Criminal &amp; Cyber Security, etc.">উদাঃ শ্রম আইন, ফৌজদারি ও সাইবার নিরাপত্তা, ইত্যাদি</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 16px;">
                        <label asp-for="ChamberAddress" class="form-label" data-bn="চেম্বার / অফিসের ঠিকানা" data-en="Chamber / Office Address">চেম্বার / অফিসের ঠিকানা</label>
                        <input asp-for="ChamberAddress" class="form-control" placeholder="উদাঃ রুম ২০৪, সুপ্রিম কোর্ট বার ভবন, ঢাকা" data-bn-placeholder="উদাঃ রুম ২০৪, সুপ্রিম কোর্ট বার ভবন, ঢাকা" data-en-placeholder="e.g. Room 204, Supreme Court Bar Building, Dhaka" />
                    </div>
                }

                <!-- Editable: Preferred Language -->
                <div class="form-group" style="margin-bottom: 24px;">
                    <label asp-for="PreferredLanguage" class="form-label" data-bn="পছন্দের ভাষা" data-en="Preferred Interface Language">পছন্দের ভাষা</label>
                    <select asp-for="PreferredLanguage" id="PreferredLanguage" class="form-control">
                        <option value="bn">বাংলা (Bengali)</option>
                        <option value="en">English (ইংরেজি)</option>
                    </select>
                    <span class="muted tiny" data-bn="নির্বাচন করলেই সাথে সাথে পুরো সাইটের ভাষা পরিবর্তন হবে" data-en="Switches the whole site's language immediately">নির্বাচন করলেই সাথে সাথে পুরো সাইটের ভাষা পরিবর্তন হবে</span>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <i data-lucide="save"></i> <span data-bn="প্রোফাইল তথ্য সংরক্ষণ করুন" data-en="Save Changes">প্রোফাইল তথ্য সংরক্ষণ করুন</span>
                </button>
            </form>
        </div>

        <!-- Right: Role Quick Stats & Security Settings -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            
            @if (!isAdmin)
            {
                <!-- Role Overview Card -->
                <div class="card" style="padding: 24px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">
                        <h2 style="font-size: 18px; margin: 0;"><i data-lucide="activity" style="display: inline; vertical-align: middle; color: var(--gold);"></i> <span data-bn="কাজের বিবরণী ও দ্রুত লিঙ্ক" data-en="Activity &amp; Quick Links">কাজের বিবরণী ও দ্রুত লিঙ্ক</span></h2>
                    </div>

                    @if (isLawyer)
                    {
                        <p style="font-size: 14px; color: var(--ink-2); margin-bottom: 14px;" data-bn="নাগরিকদের এআই প্রস্তুতকৃত আইনি ড্রাফটগুলো আপনার পর্যালোচনার মাধ্যমে চূড়ান্ত আইনি বৈধতা ও PDF ডাউনলোডযোগ্যতা পায়।" data-en="Citizens' AI-prepared legal drafts gain final legal validity and PDF download eligibility through your review.">
                            নাগরিকদের এআই প্রস্তুতকৃত আইনি ড্রাফটগুলো আপনার পর্যালোচনার মাধ্যমে চূড়ান্ত আইনি বৈধতা ও PDF ডাউনলোডযোগ্যতা পায়।
                        </p>
                        <div style="background: rgba(146, 116, 56, 0.08); padding: 14px; border-radius: var(--radius-btn); border: 1px solid var(--gold-soft); margin-bottom: 16px;">
                            <div style="font-size: 13px; color: #4a3812; font-weight: 700;" data-bn="স্বীকৃত আইনি দায়িত্ব" data-en="Human-in-the-Loop Safeguard">স্বীকৃত আইনি দায়িত্ব</div>
                            <div style="font-size: 12.5px; color: var(--ink-2); margin-top: 4px;" data-bn="আইনজীবী হিসেবে আপনার প্রতিটি অনুমোদন সরাসরি কোর্ট ও থানার ফরম্যাটে কার্যকর হয়।" data-en="As an advocate, each of your approvals takes effect directly in court and police-station formats.">আইনজীবী হিসেবে আপনার প্রতিটি অনুমোদন সরাসরি কোর্ট ও থানার ফরম্যাটে কার্যকর হয়।</div>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <a asp-controller="Lawyer" asp-action="Queue" class="btn btn-primary btn-sm" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
                                <i data-lucide="file-check-2"></i> <span data-bn="আইনজীবী রিভিউ কিউতে যান" data-en="Go to Review Queue">আইনজীবী রিভিউ কিউতে যান</span>
                            </a>
                            <a asp-controller="Lawyer" asp-action="History" class="btn btn-outline btn-sm" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
                                <i data-lucide="history"></i> <span data-bn="রিভিউ ইতিহাস" data-en="Review History">রিভিউ ইতিহাস</span>
                            </a>
                            <a asp-controller="Lawyer" asp-action="Payments" class="btn btn-outline btn-sm" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
                                <i data-lucide="wallet"></i> <span data-bn="আয় ও পেমেন্ট" data-en="Earnings &amp; Payments">আয় ও পেমেন্ট</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <p style="font-size: 14px; color: var(--ink-2); margin-bottom: 14px;" data-bn="আপনার দায়েরকৃত আইনি সমস্যাসমূহ এবং আইনজীবী দ্বারা পর্যালোচিত ড্রাফটসমূহ সহজে ট্র্যাক করুন।" data-en="Easily track the legal issues you have filed and drafts reviewed by lawyers.">
                            আপনার দায়েরকৃত আইনি সমস্যাসমূহ এবং আইনজীবী দ্বারা পর্যালোচিত ড্রাফটসমূহ সহজে ট্র্যাক করুন।
                        </p>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <a asp-controller="Case" asp-action="Track" class="btn btn-outline" style="display: flex; align-items: center; justify-content: space-between;">
                                <span><i data-lucide="folder-clock" style="display: inline; vertical-align: middle;"></i> <span data-bn="আমার দায়েরকৃত মামলাসমূহ" data-en="My Filed Cases">আমার দায়েরকৃত মামলাসমূহ</span></span>
                                <i data-lucide="chevron-right"></i>
                            </a>
                            <a asp-controller="Case" asp-action="Submit" class="btn btn-primary" style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                                <i data-lucide="plus-circle"></i> <span data-bn="নতুন আইনি সমস্যা জমা দিন" data-en="Submit a New Legal Issue">নতুন আইনি সমস্যা জমা দিন</span>
                            </a>
                        </div>
                    }
                </div>
            }

            <!-- Password Change Card -->
            <div class="card" style="padding: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">
                    <h2 style="font-size: 18px; margin: 0;"><i data-lucide="key-round" style="display: inline; vertical-align: middle; color: var(--gold);"></i> <span data-bn="পাসওয়ার্ড ও নিরাপত্তা" data-en="Security &amp; Password">পাসওয়ার্ড ও নিরাপত্তা</span></h2>
                </div>

                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label class="form-label" data-bn="বর্তমান পাসওয়ার্ড" data-en="Current Password">বর্তমান পাসওয়ার্ড</label>
                        <input name="CurrentPassword" type="password" class="form-control" required placeholder="••••••••" />
                    </div>

                    <div class="form-group" style="margin-bottom: 14px;">
                        <label class="form-label" data-bn="নতুন পাসওয়ার্ড" data-en="New Password">নতুন পাসওয়ার্ড</label>
                        <input name="NewPassword" type="password" class="form-control" required placeholder="••••••••" />
                        <span class="muted tiny" data-bn="কমপক্ষে ৮ অক্ষর (বড় ও ছোট হাতের অক্ষর, সংখ্যা ও স্পেশাল চিহ্ন)" data-en="At least 8 characters (upper and lower case letters, a number and a special character)">কমপক্ষে ৮ অক্ষর (বড় ও ছোট হাতের অক্ষর, সংখ্যা ও স্পেশাল চিহ্ন)</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 18px;">
                        <label class="form-label" data-bn="নতুন পাসওয়ার্ড নিশ্চিত করুন" data-en="Confirm New Password">নতুন পাসওয়ার্ড নিশ্চিত করুন</label>
                        <input name="ConfirmNewPassword" type="password" class="form-control" required placeholder="••••••••" />
                    </div>

                    <button type="submit" class="btn btn-outline" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <i data-lucide="shield-check"></i> <span data-bn="পাসওয়ার্ড আপডেট করুন" data-en="Update Password">পাসওয়ার্ড আপডেট করুন</span>
                    </button>
                </form>

                <form asp-action="LogoutEverywhere" method="post" style="margin-top: 12px">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-quiet btn-sm" type="submit" data-confirm="সব ডিভাইস থেকে লগ আউট হবে — নিশ্চিত? / Sign out everywhere?">
                        <i data-lucide="log-out"></i> <span data-bn="সব ডিভাইস থেকে লগ আউট" data-en="Log out everywhere">সব ডিভাইস থেকে লগ আউট</span>
                    </button>
                </form>
            </div>

        </div>
    </div>
</main>

@if (isCitizen)
{
    <partial name="_TopUpModal" />
}
<script src="~/assets/js/payment.js" asp-append-version="true" defer></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var langSelect = document.getElementById("PreferredLanguage");
        if (!langSelect || !window.mktLang) return;

        // The saved DB value only reflects what was true at last Save; the page
        // actually displayed can differ (e.g. switched via the header toggle
        // since then), so sync the select to that instead of the model value.
        langSelect.value = window.mktLang.get();

        // Switch the whole site immediately, same as the header বাং/EN toggle.
        // Saving the form still persists this value to PreferredLanguage as before.
        langSelect.addEventListener("change", function () {
            window.mktLang.set(langSelect.value);
        });
    });
</script>
